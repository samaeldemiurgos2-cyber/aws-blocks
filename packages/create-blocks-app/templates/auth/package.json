{
  "name": "blocks-auth-app",
  "version": "0.1.0",
  "type": "module",
  "blocksTemplate": "auth",
  "blocksTemplateDescription": "Vite + vanilla-DOM tour of the Auth block: email sign-up with code, groups, profile (was auth-cognito)",
  "engines": {
    "node": ">=22.0.0"
  },
  "workspaces": [
    "cdk-blocks"
  ],
  "scripts": {
    "typecheck": "tsc -b --force",
    "spec": "cdk-blocks generate spec",
    "dev:server": "cdk-blocks dev",
    "dev": "cdk-blocks dev",
    "dev:stop": "cdk-blocks dev stop",
    "sandbox": "cdk-blocks sandbox",
    "sandbox:deploy": "cdk-blocks sandbox deploy",
    "sandbox:preview": "cdk-blocks sandbox preview",
    "sandbox:destroy": "cdk-blocks sandbox destroy",
    "sandbox:console": "cdk-blocks sandbox console",
    "cleanup": "cdk-blocks dev stop --all",
    "prebuild": "cdk-blocks generate client",
    "build": "tsc -b --force && vite build",
    "preview": "vite preview",
    "deploy": "cdk-blocks deploy",
    "secret": "cdk-blocks secret",
    "config": "cdk-blocks config",
    "typegen": "cdk-blocks generate types",
    "destroy": "cdk-blocks destroy",
    "test:e2e": "tsx --tsconfig tsconfig.node.json -C browser --test-force-exit test/e2e.test.ts",
    "docs": "cdk-blocks docs",
    "docs:search": "cdk-blocks docs --search",
    "docs:api": "cdk-blocks docs --api",
    "db": "cdk-blocks db",
    "whoami": "cdk-blocks whoami",
    "migrate": "cdk-blocks migrate",
    "help": "cdk-blocks --help",
    "generate-client": "cdk-blocks generate client",
    "vendorize": "cdk-blocks vendorize"
  },
  "blocks": {
    "dev": {
      "frontendPort": 3100
    }
  },
  "dependencies": {
    "aws-cdk-blocks": "*",
    "@aws-cdk-blocks/hosting": "*",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.12.0",
    "typescript": "^5.9.3",
    "vite": "^6.4.5",
    "tsx": "^4.23.15",
    "esbuild": "^0.28.2",
    "aws-cdk": "^2.1147.0",
    "aws-cdk-lib": "^2.275.0",
    "constructs": "^10.8.1"
  }
}
